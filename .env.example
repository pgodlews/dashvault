# .env.example — copy to .env and fill in your values.
# .env is git-ignored; this file IS committed as a reference.
#
# On the Pi, Telegram credentials live in /mutable/teslausb_telegram.env
# and archive credentials in /root/teslausb_setup_variables.conf.

# ── Telegram bot ──────────────────────────────────────────────────────────────
# Create a bot via @BotFather → /newbot, then get your chat ID from:
#   https://api.telegram.org/bot<TOKEN>/getUpdates  (after sending the bot any message)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SILENT_NOTIFY=false        # true = no notification sound

# ── Pi access ─────────────────────────────────────────────────────────────────
PI_HOST=dashvault.local
PI_USER=pi
PI_PASS=                            # default: raspberry

# ── Archive backend ───────────────────────────────────────────────────────────
# Supported: cifs | nfs | rsync | rclone | none
ARCHIVE_SYSTEM=cifs

# CIFS (Windows/Samba share)
ARCHIVE_SERVER=                     # IP or hostname of NAS
SHARE_NAME=                         # e.g. tesla/dashcam
SHARE_USER=
SHARE_PASSWORD=
# SHARE_DOMAIN=                     # optional, usually not needed
# CIFS_VERSION=3.0                  # optional
# CIFS_SEC=ntlm                     # optional

# NFS
# NFS_SERVER=
# NFS_PATH=                         # e.g. /volume1/tesla

# rsync over SSH
# RSYNC_USER=
# RSYNC_SERVER=
# RSYNC_PATH=                       # e.g. /media/tesla

# rclone (configure rclone separately with `rclone config`)
# RCLONE_DRIVE=                     # rclone remote name
# RCLONE_PATH=                      # path within the remote
