[Unit]
Description=TeslaUSB Telegram bot (inbound commands)
After=network-online.target teslausb.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/mutable/teslausb_telegram.env
ExecStart=/usr/bin/python3 /root/bin/teslausb_telegram_bot.py
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=teslausb-telegram-bot

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/mutable /backingfiles /mnt /tmp /run/teslausb

[Install]
WantedBy=multi-user.target
