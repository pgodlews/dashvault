#!/bin/bash -eu

# Secures sensitive configuration files that contain secrets
# (e.g., WiFi passwords, Tesla tokens, Web UI credentials).

echo "Securing permissions on secrets files"

# 1. teslausb_setup_variables.conf
for conf_file in /root/teslausb_setup_variables.conf /teslausb/teslausb_setup_variables.conf /boot/teslausb_setup_variables.conf; do
    if [ -f "$conf_file" ]; then
        # Ensure root ownership and read-write only for root
        chown root:root "$conf_file"
        chmod 600 "$conf_file"
        echo "Secured $conf_file (chmod 600)"
    fi
done

# 2. wpa_supplicant.conf
if [ -f "/etc/wpa_supplicant/wpa_supplicant.conf" ]; then
    chown root:root /etc/wpa_supplicant/wpa_supplicant.conf
    chmod 600 /etc/wpa_supplicant/wpa_supplicant.conf
    echo "Secured /etc/wpa_supplicant/wpa_supplicant.conf (chmod 600)"
fi
