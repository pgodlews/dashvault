#!/bin/bash -e
#
# rc.local
#
# This script is executed at the end of each multiuser runlevel.
# Make sure that the script will "exit 0" on success or any other
# value on error.
#
# In order to enable or disable this script just change the execution
# bits.
#
# By default this script does nothing.

# Print the IP address
_IP=$(hostname -I) || true
if [ "$_IP" ]
then
  printf "My IP address is %s\n" "$_IP"
fi

if [ ! -L /teslausb ]
then
  rm -rf /teslausb
  if [ -d /boot/firmware ] && findmnt --fstab /boot/firmware &> /dev/null
  then
    ln -s /boot/firmware /teslausb
  else
    ln -s /boot /teslausb
  fi
fi

if [ -f /teslausb/run_once ]
then
  cp /teslausb/run_once /tmp/
  chmod +x /tmp/run_once
  /tmp/run_once || echo "run_once failed"
  # The boot partition is read-only once setup has finished. Without this the
  # script would stay in place and run again on every boot.
  boot_mount=$(findmnt -no TARGET --target /teslausb/)
  boot_was_ro=false
  if findmnt -no OPTIONS "$boot_mount" | tr ',' '\n' | grep -qx ro
  then
    boot_was_ro=true
    mount -o remount,rw "$boot_mount" || true
  fi
  mv /teslausb/run_once /teslausb/ran_once || true
  if [ "$boot_was_ro" = true ]
  then
    sync
    mount -o remount,ro "$boot_mount" || true
  fi
fi

SETUP_LOGFILE=/teslausb/teslausb-headless-setup.log

function write_all_leds {
  for led in /sys/class/leds/*
  do
    echo "$1" > "$led/$2" || true
  done &> /dev/null
}

function error_strobe() {
  modprobe ledtrig_timer || true
  write_all_leds timer trigger
  while true
  do
    write_all_leds 1 delay_on
    write_all_leds 100 delay_off
    sleep 1
    write_all_leds 0 delay_on
    sleep 1
  done
}

function setup_progress () {
  echo "$( date ) : $1" >> "$SETUP_LOGFILE" || echo "can't write to $SETUP_LOGFILE"
  echo "$1"
}

function get_script () {
  local local_path="$1"
  local name="$2"
  local remote_path="${3:-}"

  if [ -n "${SOURCE_DIR:-}" ] && [ -f "$SOURCE_DIR/$remote_path/$name" ]
  then
    cp "$SOURCE_DIR/$remote_path/$name" "$local_path/$name"
    chmod +x "$local_path/$name"
    return 0
  fi

  IFS=". " read -r start_time _ < /proc/uptime

  while ! curl -o "$local_path/$name" https://raw.githubusercontent.com/"$REPO"/dashvault/"$BRANCH"/"$remote_path"/"$name"
  do
    setup_progress "get_script failed, retrying"
    sntp -S time.google.com || ntpdig -S time.google.com || true
    sleep 3
    IFS=". " read -r now _ < /proc/uptime
    if [ $((now - start_time)) -gt 60 ]
    then
      setup_progress "failed to get script after 60 seconds, exiting"
      return 1
    fi
  done
  chmod +x "$local_path/$name"
}

# Delete saved profiles for this network. A failed "nmcli device wifi connect"
# can leave one behind with the wrong password, and it then gets in the way of
# the next attempt with the right one.
function forget_wifi () {
  local uuid
  while read -r uuid
  do
    if [ "$(nmcli --escape no -g 802-11-wireless.ssid connection show "$uuid" 2>/dev/null)" = "$SSID" ]
    then
      nmcli connection delete uuid "$uuid" &> /dev/null || true
    fi
  done < <(nmcli -g UUID,TYPE connection show 2>/dev/null | sed -n 's/:802-11-wireless$//p')
}

function nm_connect_wifi () {
  local attempt output deadline=$((SECONDS + 180))
  local connect_args

  rfkill unblock wifi &> /dev/null || true
  nmcli radio wifi on &> /dev/null || true
  forget_wifi

  for attempt in 1 2 3 4 5 6 7 8
  do
    # Refused while a scan is already running, which is fine.
    nmcli device wifi rescan &> /dev/null || true
    sleep 4

    connect_args=(--wait 35 device wifi connect "$SSID")
    if [ -n "${WIFIPASS:-}" ]
    then
      connect_args+=(password "$WIFIPASS")
    fi
    # With the network in the scan list NetworkManager works out its security
    # itself. Only a network it cannot see is treated as hidden.
    if ! nmcli -t --escape no -f SSID device wifi list 2>/dev/null | grep -qxF -- "$SSID"
    then
      connect_args+=(hidden yes)
    fi

    if output=$(nmcli "${connect_args[@]}" 2>&1)
    then
      setup_progress "connected to wifi on attempt $attempt"
      return 0
    fi
    setup_progress "wifi attempt $attempt failed: $output"
    setup_progress "wifi state: $(nmcli -t -f WIFI general 2>&1 | head -1) $(nmcli -t -f DEVICE,STATE device 2>&1 | grep '^wl' | tr '\n' ' ')"
    forget_wifi
    if [ "$SECONDS" -ge "$deadline" ]
    then
      break
    fi
    sleep 3
  done
  setup_progress "failed to connect to wifi, giving up"
  return 1
}

function enable_wifi () {
  setup_progress "Detecting whether to configure wifi"
  if [[ -n "${SSID:-}" ]] && { [[ -n "${WIFIPASS:-}" ]] || systemctl -q is-enabled NetworkManager.service; }
  then
    if [ ! -e /teslausb/WIFI_ENABLED ]
    then
      if [ -x /root/bin/remountfs_rw ]
      then
        /root/bin/remountfs_rw
      fi
      if systemctl -q is-enabled NetworkManager.service
      then
        setup_progress "Connecting to wifi using Network Manager"
        if ! nm_connect_wifi
        then
          setup_progress "Failed to connect to wifi"
          # Settings entered over the hotspot or Bluetooth: go back and let the
          # user correct them instead of leaving a board with no way in.
          if [ -e /teslausb/provisioning_done ] && [ ! -e /teslausb/TESLAUSB_SETUP_FINISHED ] \
            && [ -x /root/provisioning/start.sh ]
          then
            setup_progress "Returning to the setup hotspot"
            forget_wifi
            printf 'Could not join the Wi-Fi network "%s". Check its name and password.\n' "$SSID" \
              > /teslausb/provisioning_error
            rm -f /root/teslausb_setup_variables.conf /teslausb/provisioning_done
            systemctl start --no-block teslausb-provisioning.service
            exit 0
          fi
          error_strobe &
          exit 0
        fi
      else
        setup_progress "Configuring wpa_supplicant"
        cp /teslausb/wpa_supplicant.conf.sample /teslausb/wpa_supplicant.conf
        sed -i -e "sTEMPSSID${SSID}g" /teslausb/wpa_supplicant.conf
        sed -i -e "sTEMPPASS${WIFIPASS}g" /teslausb/wpa_supplicant.conf
        cp /teslausb/wpa_supplicant.conf /etc/wpa_supplicant/wpa_supplicant.conf
      fi

      # set the host name now if possible, so it's effective immediately after the reboot
      local old_host_name
      old_host_name=$(cat /etc/hostname)
      if [[ -n "$TESLAUSB_HOSTNAME" ]] && [[ "$TESLAUSB_HOSTNAME" != "$old_host_name" ]]
      then
        local new_host_name="$TESLAUSB_HOSTNAME"
        sed -i -e "s/$old_host_name/$new_host_name/g" /etc/hosts
        sed -i -e "s/$old_host_name/$new_host_name/g" /etc/hostname
      fi

      dpkg-reconfigure -f noninteractive openssh-server
      rfkill unblock wifi &> /dev/null || true
      for i in /var/lib/systemd/rfkill/*:wlan ; do
        echo 0 > "$i"
      done
      systemctl enable ssh

      touch /teslausb/WIFI_ENABLED
      setup_progress "Rebooting..."
      exec reboot
    fi
  else
    setup_progress "skipping wifi setup because variables not specified"
  fi
}

function safesource {
  cat <<EOF > /tmp/checksetupconf
#!/bin/bash -eu
source '$1' &> /tmp/checksetupconf.out
EOF
  chmod +x /tmp/checksetupconf
  if ! /tmp/checksetupconf
  then
    setup_progress "Error in $1:"
    setup_progress "$(cat /tmp/checksetupconf.out)"
    error_strobe &
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$1"
}

if [ -e "/teslausb/teslausb_setup_variables.conf" ]
then
  if [ -e /root/bin/remountfs_rw ]
  then
    /root/bin/remountfs_rw
  fi
  mv /teslausb/teslausb_setup_variables.conf /root/
  dos2unix /root/teslausb_setup_variables.conf
fi
if [ -e "/root/teslausb_setup_variables.conf" ]
then
  safesource /root/teslausb_setup_variables.conf
elif [ -e "/teslausb/teslausb_setup_variables.conf.sample" ]
then
  setup_progress "no config file found, but sample file is present."
else
  setup_progress "no config file found."
fi

# A fresh image with no configuration file: set up over the hotspot or
# Bluetooth. That writes the file and reboots back into this script. The service
# is started from here, not enabled, so it cannot race the move of a file from
# the boot partition above.
if [ ! -e /root/teslausb_setup_variables.conf ] && [ ! -e /teslausb/TESLAUSB_SETUP_FINISHED ] \
  && [ -x /root/provisioning/start.sh ] && [ -e /etc/systemd/system/teslausb-provisioning.service ]
then
  rm -f /teslausb/provisioning_done
  setup_progress "No configuration file: waiting for setup over the hotspot or Bluetooth."
  systemctl start --no-block teslausb-provisioning.service
  exit 0
fi

# Replace the image's well-known password before this board joins any network.
# Setup sets it again much later, after the packages are installed.
if [ -n "${PI_PASSWORD:-}" ] && [ ! -e /teslausb/TESLAUSB_SETUP_FINISHED ]
then
  default_user=$(awk -F: '$3 == 1000 && $4 == 1000 { print $1; exit }' /etc/passwd)
  if [ -n "$default_user" ]
  then
    printf '%s:%s\n' "$default_user" "$PI_PASSWORD" | chpasswd || setup_progress "could not change the password of $default_user"
  fi
fi

# check if we previously marked wifi as enabled
enable_wifi
# Good to start setup at this point

# This begins the Headless Setup loop
# If the FINISHED file does not exist then we start setup. Otherwise passes on to normal loop
if [ ! -e "/teslausb/TESLAUSB_SETUP_FINISHED" ]
then
  if [ -e /root/bin/remountfs_rw ]
  then
    /root/bin/remountfs_rw
  fi
  touch "/teslausb/TESLAUSB_SETUP_STARTED"

  if [ -e "/root/teslausb_setup_variables.conf" ]
  then
    source "/root/teslausb_setup_variables.conf"
  else
    # No conf file found, can't complete setup
    setup_progress "Setup appears not to have completed, but you didn't provide a teslausb_setup_variables.conf."
  fi

  # The SD image carries the release it was built from, prebuilt, in
  # /usr/local/share/teslausb-release. Install from it instead of downloading,
  # unless the configuration names a repository or branch, "setup-teslausb
  # upgrade" asked for the newest code, or something newer has since replaced
  # what the image installed (then the copy in the image is the older one).
  if [ -z "${SOURCE_DIR:-}" ] && [ -z "${REPO:-}" ] && [ -z "${BRANCH:-}" ] \
    && [ "${TESLAUSB_IGNORE_BUNDLED_RELEASE:-}" != 1 ] \
    && [ -f /usr/local/share/teslausb-release/VERSION ]
  then
    if [ ! -f /root/teslausb_version ] \
      || cmp -s /usr/local/share/teslausb-release/VERSION /root/teslausb_version
    then
      export SOURCE_DIR=/usr/local/share/teslausb-release
    fi
  fi

  # Make the bin dir if needed to grab the setup script into it and persist
  if [ ! -d "/root/bin" ]
  then
    mkdir "/root/bin"
  fi

  if [ ! -e "/root/bin/setup-teslausb" ]
  then
    REPO=${REPO:-pgodlews}
    BRANCH=${BRANCH:-main}
    # Script doesn't exist, grab it.
    setup_progress "Grabbing main setup file."
    if ! get_script /root/bin setup-teslausb setup/pi
    then
      setup_progress "Failed to retrieve setup script. Check network settings."
      error_strobe &
      exit 0
    fi
  fi

  setup_progress "Starting setup."

  # Start setup. This should take us all the way through to reboot
  if ! /root/bin/setup-teslausb
  then
    if [ -d /var/www/html ]
    then
      echo '{"failed":true}' > /var/www/html/setup-status.json || true
    fi
    error_strobe &
    exit 0
  fi

  # reboot for good measure, also restarts the rc.local script
  exec reboot
fi

# The system journal is lost at power-off, so keep the evidence if this board
# has no network a few minutes after booting. NetworkManager's log holds no
# passwords.
if [ -e /teslausb/TESLAUSB_SETUP_FINISHED ]
then
  (
    set +e
    sleep 180
    if findmnt -n /mutable > /dev/null && ! nmcli -t -f STATE general 2>/dev/null | grep -q '^connected'
    then
      {
        date
        nmcli general
        nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device
        rfkill list
        dmesg | grep -i -E 'brcm|wlan|cfg80211' | tail -30
        journalctl -b -u NetworkManager -u wpa_supplicant --no-pager -n 150
      } > /mutable/wifi-boot-failure.log 2>&1
    fi
  ) > /dev/null 2>&1 < /dev/null &
fi

# we're done. If setup completed successfully, teslausb will have been
# started as a systemd service at this point

exit 0
